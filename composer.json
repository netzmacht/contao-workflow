{
  "name": "netzmacht/contao-workflow",
  "description": "Library for supporting customized Contao form rendering",
  "license": "LGPL-3.0-or-later",
  "type": "contao-bundle",
  "keywords": [
    "contao",
    "workflow",
    "data flow"
  ],
  "authors": [
    {
      "name": "David Molineus",
      "email": "mail@netzmacht.de",
      "homepage": "https://netzmacht.de"
    }
  ],
  "support": {
    "email": "mail@netzmacht.de",
    "issues": "https://github.com/netzmacht/contao-workflow/issues",
    "source": "https://github.com/netzmacht/contao-workflow"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "beberlei/assert": "^3.0",
    "contao-community-alliance/meta-palettes": "^2.0",
    "contao/core-bundle": "^5.3",
    "doctrine/dbal": "^2.13 || ^3.1",
    "friends-of-contao/contao-associategroups": "dev-develop",
    "mathiasverraes/classfunctions": "~1.1",
    "menatwork/contao-multicolumnwizard-bundle": "^3.3.14",
    "netzmacht/contao-form-bundle": "^2.0",
    "netzmacht/contao-toolkit": "^4.0",
    "netzmacht/workflow": "dev-develop",
    "patchwork/utf8": "^1.2",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "sensio/framework-extra-bundle": "^6.2",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/event-dispatcher": "^6.4 || ^7.0",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/expression-language": "^6.4 || ^7.0",
    "symfony/form": "^6.4 || ^7.0",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/options-resolver": "^6.4 || ^7.0",
    "symfony/routing": "^6.4 || ^7.0",
    "symfony/security-core": "^6.4 || ^7.0",
    "symfony/templating": "^6.4 || ^7.0",
    "symfony/translation": "^6.4 || ^7.0",
    "symfony/translation-contracts": "^3.0",
    "symfony/validator": "^6.4 || ^7.0",
    "terminal42/notification_center": "^2.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.1",
    "friends-of-phpspec/phpspec-expect": "^4.0",
    "phpcq/runner-bootstrap": "@dev",
    "phpspec/phpspec": "^7.1",
    "netzmacht/phpspec-phpcq-plugin": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Netzmacht\\ContaoWorkflowBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\Netzmacht\\ContaoWorkflowBundle\\": "spec/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "contao-community-alliance/composer-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-develop": "2.6.x-dev",
      "dev-master": "2.5.x-dev"
    },
    "contao": {
      "transifex": {
        "languages_cto": "src/Resources/contao/languages",
        "languages_tx": ".tx",
        "prefix": "",
        "project": "contao-workflow"
      }
    },
    "contao-manager-plugin": "Netzmacht\\ContaoWorkflowBundle\\ContaoManager\\Plugin"
  },
  "conflict": {
    "contao/manager-plugin": "<2.1 || >= 3.0"
  }
}
