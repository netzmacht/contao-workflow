{% extends '@Contao/be_main' %}
{% set headline = include(sections.template('headline'), sections.get('headline'))|trim %}

{%- block error -%}

{%- endblock -%}

{% block main_content %}
    <div id="tl_buttons">
        <a href="javascript:history.back();" class="header_back" title="">{{ 'MSC.backBT'|trans({}, 'contao_default') }}</a>
    </div>

    {% for name, section in sections %}
        {% if name != 'headline' %}
            {% set content = include(sections.template(name), section)|trim %}
            {% if content|length %}
                <div class="workflow-section">
                    {{ content|raw }}
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}

{% endblock %}
