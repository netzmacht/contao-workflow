{
  "receipts": [
    "projects/contao-bundle/5.3"
  ],
  "config": {
    "phpConstraint": "^8.3",
    "directories": [
      "spec"
    ]
  },
  "tools": {
    "composer": {
      "namespace": "Netzmacht\\ContaoWorkflowBundle"
    },
    "phpcq": {
      "plugins": {
        "phpunit": false,
        "rector": false,
        "phpspec": true
      },
      "defaults": {
        "repositories": [
          "vendor/netzmacht/phpspec-phpcq-plugin/repository.json"
        ]
      },
      "presets": {
        "composer-require-checker": {
          "tasks": {
            "composer-require-checker": {
              "config":{
                "config_file": ".composer-require-checker.json"
              }
            }
          }
        }
      }
    },
    "psalm": {
      "configuration": {
        "errorLevel": "3"
      }
    }
  }
}
